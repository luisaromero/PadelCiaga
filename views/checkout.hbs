<section class="container py-5 checkout-page">

  <div class="checkout-header">

    <h1>Checkout</h1>

    <p>
      Completa tus datos para preparar tu pedido.
    </p>
  </div>

  <div class="row g-5">

    <!-- DATOS -->
    <div class="col-lg-7">

      <form id="checkout-form">

        <div class="checkout-section">

          <span class="checkout-label">
            DATOS DE CONTACTO
          </span>

          <div class="row g-3">

            <div class="col-md-6">
              <label for="nombre">Nombre</label>

              <input
                type="text"
                id="nombre"
                name="nombre"
                class="form-control checkout-input"
                required
              />
            </div>

            <div class="col-md-6">
              <label for="apellido">Apellido</label>

              <input
                type="text"
                id="apellido"
                name="apellido"
                class="form-control checkout-input"
                required
              />
            </div>

            <div class="col-md-7">
              <label for="email">Email</label>

              <input
                type="email"
                id="email"
                name="email"
                class="form-control checkout-input"
                required
              />
            </div>

            <div class="col-md-5">
              <label for="telefono">Teléfono</label>

              <input
                type="tel"
                id="telefono"
                name="telefono"
                class="form-control checkout-input"
                placeholder="+56 9..."
                required
              />
            </div>

          </div>

        </div>

        <div class="checkout-section">

          <span class="checkout-label">
            DIRECCIÓN DE ENVÍO
          </span>

          <div class="row g-3">

            <div class="col-md-6">

              <label for="region">
                Región
              </label>

              <select
                id="region"
                name="region"
                class="form-select checkout-input"
                required
              >

                <option value="">
                  Selecciona una región
                </option>

                <option>
                  Arica y Parinacota
                </option>

                <option>
                  Tarapacá
                </option>

                <option>
                  Antofagasta
                </option>

                <option>
                  Atacama
                </option>

                <option>
                  Coquimbo
                </option>

                <option>
                  Valparaíso
                </option>

                <option>
                  Metropolitana de Santiago
                </option>

                <option>
                  O'Higgins
                </option>

                <option>
                  Maule
                </option>

                <option>
                  Ñuble
                </option>

                <option>
                  Biobío
                </option>

                <option>
                  La Araucanía
                </option>

                <option>
                  Los Ríos
                </option>

                <option>
                  Los Lagos
                </option>

                <option>
                  Aysén
                </option>

                <option>
                  Magallanes
                </option>

              </select>

            </div>

            <div class="col-md-6">

              <label for="comuna">
                Comuna
              </label>

              <input
                type="text"
                id="comuna"
                name="comuna"
                class="form-control checkout-input"
                required
              />

            </div>

            <div class="col-md-8">

              <label for="direccion">
                Dirección
              </label>

              <input
                type="text"
                id="direccion"
                name="direccion"
                class="form-control checkout-input"
                placeholder="Ej. Av. Providencia"
                required
              />

            </div>

            <div class="col-md-4">

              <label for="numero">
                Número
              </label>

              <input
                type="text"
                id="numero"
                name="numero"
                class="form-control checkout-input"
                required
              />

            </div>

            <div class="col-md-6">

              <label for="departamento">
                Departamento
                <span class="optional">
                  (opcional)
                </span>
              </label>

              <input
                type="text"
                id="departamento"
                name="departamento"
                class="form-control checkout-input"
              />

            </div>

          </div>

        </div>

        <button type="submit" class="checkout-btn">
          Confirmar pedido
        </button>

      </form>

    </div>

    <!-- RESUMEN -->
    <div class="col-lg-5">

      <aside class="checkout-summary">

        <span class="checkout-label">
          RESUMEN DEL PEDIDO
        </span>

        <div id="checkout-items"></div>

        <div class="summary-line">
          <span>Subtotal</span>

          <strong id="checkout-subtotal">
            $0
          </strong>
        </div>

        <div class="summary-line">
          <span>Envío</span>

          <span>Gratis</span>
        </div>

        <div class="summary-total">

          <span>Total</span>

          <strong id="checkout-total">
            $0
          </strong>

        </div>

      </aside>

    </div>

  </div>

</section>