<section class="container py-5 order-success">

  <div class="text-center">

    <h1 class="section-title">
      ¡Gracias por tu compra!
    </h1>

    <p class="order-success-message">
      Tu pedido ha sido recibido correctamente.
    </p>

    <div class="order-success-card">

      <span class="order-success-label">
        NÚMERO DE PEDIDO
      </span>

      <strong id="order-number">
        #{{orderId}}
      </strong>

      <p>
        Hemos registrado tu pedido y pronto podrás revisar sus detalles.
      </p>

    </div>

    <a href="/" class="order-success-btn">
      Volver a la tienda
    </a>

  </div>

</section>