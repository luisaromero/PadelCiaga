<header>

  <div class="top-bar">
    NUEVA COLECCIÓN · CREATED FOR WOMEN WHO PLAY
  </div>

  <nav class="navbar navbar-expand-lg navbar-light bg-white py-4">
    <div class="container">

      <a class="navbar-brand logo" href="/">
        PADEL CIAGA
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarPadel"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarPadel">

        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link" href="/">Inicio</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/about">About</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/contact">Contacto</a>
          </li>
          {{#if user}}

            <li class="nav-item">
              <span class="nav-link">
                Hola,
                <span class="user-name">
                  {{user.nombre}}
                </span>
              </span>
            </li>
            <li class="nav-item">

              <form action="/logout" method="POST">

                <button type="submit" class="nav-link logout-btn">
                  Cerrar sesión
                </button>

              </form>

            </li>

          {{else}}

            <li class="nav-item">
              <a class="nav-link" href="/login">
                Iniciar sesión
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/register">
                Registro
              </a>
            </li>

          {{/if}}
          <button
            class="cart-btn"
            data-bs-toggle="offcanvas"
            data-bs-target="#shoppingCart"
          >

            <i class="bi bi-bag"></i>

            <span id="cart-count">
              0
            </span>

          </button>

        </ul>

      </div>

    </div>
  </nav>

</header>