<section class="container py-5">

  <div class="row g-5 align-items-center">

    <div class="col-lg-6">

      <img
        src="{{product.imagen}}"
        alt="{{product.nombre}}"
        class="img-fluid"
      />

    </div>

    <div
      class="col-lg-6"
      data-product-id="{{product.id}}"
      data-product-name="{{product.nombre}}"
      data-product-price="{{product.precio}}"
      data-product-image="{{product.imagen}}"
    >

      <h1>
        {{product.nombre}}
      </h1>

      <p>
        {{formatCLP product.precio}}
      </p>

      <h2>
        Variantes
      </h2>

      <div>

        {{#each product.variants}}

          <button type="button" class="variant-option" data-variant-id="{{id}}">
            {{talla}}
          </button>

        {{/each}}

      </div>

      <button type="button" class="add-product-btn">
        Agregar al carrito
      </button>

    </div>

  </div>

</section>