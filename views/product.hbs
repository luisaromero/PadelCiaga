<section class="container py-5">

  <div class="row align-items-center g-5">

    <!-- IMAGEN -->
    <div class="col-lg-6">

      <img
        src="{{product.imagen}}"
        alt="{{product.nombre}}"
        class="product-detail-image"
      />

    </div>

    <!-- INFORMACIÓN -->
    <div
      class="col-lg-6"
      data-product-id="{{product.id}}"
      data-product-name="{{product.nombre}}"
      data-product-price="{{product.precio}}"
      data-product-image="{{product.imagen}}"
    >

      <nav class="breadcrumb-product" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/">Productos</a>
        <span>/</span>
        <span>{{product.nombre}}</span>
      </nav>

      <h1>
        {{product.nombre}}
      </h1>

      <p class="product-price">
        {{formatCLP product.precio}}
      </p>
      <!-- COLOR -->
      <div class="product-color">

        <span class="color-label">
          Color:
        </span>

        <span class="color-name">
          Negro
        </span>

        <span class="color-circle" aria-label="Color negro"></span>

      </div>

      <!-- DESCRIPCIÓN -->
      <p class="product-description">
        {{product.descripcion}}
      </p>

      <!-- TALLAS -->
      <div class="product-options">

        <p class="option-title">
          Selecciona tu talla
        </p>

        <div class="variant-options">

          {{#each product.variants}}

            <button
              type="button"
              class="variant-option"
              data-variant-id="{{id}}"
            >
              {{talla}}
            </button>

          {{/each}}

        </div>

      </div>

      <!-- CANTIDAD -->
      <div class="quantity-selector">

        <p class="option-title">
          Cantidad
        </p>

        <div class="quantity-controls">

          <button type="button" class="quantity-minus">
            −
          </button>

          <span class="quantity-value">
            1
          </span>

          <button type="button" class="quantity-plus">
            +
          </button>

        </div>

      </div>

      <!-- AGREGAR -->
      <button type="button" class="add-product-btn">
        Agregar al carrito
      </button>

      <!-- BENEFICIOS -->
      <div class="product-benefits">

        <div class="benefit-card">

          <i class="bi bi-shop"></i>

          <div>
            <strong>Retiro GRATIS</strong>
            <span>en tienda</span>
          </div>

        </div>

        <div class="benefit-card">

          <i class="bi bi-arrow-left-right"></i>

          <div>
            <strong>Cambios</strong>
            <span>hasta 60 días</span>
          </div>

        </div>

        <div class="benefit-card">

          <i class="bi bi-credit-card"></i>

          <div>
            <strong>Hasta 6 cuotas</strong>
            <span>sin interés</span>
          </div>

        </div>

      </div>

    </div>

  </div>

</section>